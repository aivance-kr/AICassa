#!/bin/sh
# pre-commit: 스테이징된 PHP 파일을 PHP CS Fixer 로 자동 포맷 후 재-스테이징한다.
# CS 위반이 CI 에서야 발견돼 커밋 왕복이 생기는 것을 근본 차단한다.
# 긴급 시 우회: SKIP_HOOKS=1 git commit ...

[ -n "$SKIP_HOOKS" ] && { echo "⏭  pre-commit: SKIP_HOOKS 설정됨 — 건너뜀"; exit 0; }

# 스테이징된(추가·수정·복사·이름변경) PHP 파일만 대상
FILES=$(git diff --cached --name-only --diff-filter=ACMR -- '*.php')
[ -z "$FILES" ] && exit 0

FIXER="vendor/bin/php-cs-fixer"
if [ ! -x "$FIXER" ]; then
    echo "⚠ pre-commit: $FIXER 없음 — CS 자동수정 건너뜀 (composer install 필요)"
    exit 0
fi

echo "▶ pre-commit: 스테이징된 PHP 파일 CS 자동수정…"
# 대상 파일만 포맷(--path-mode=intersection 로 .php-cs-fixer 규칙 ∩ 지정 파일)
echo "$FILES" | PHP_CS_FIXER_IGNORE_ENV=1 xargs "$FIXER" fix --config=.php-cs-fixer.dist.php --path-mode=intersection --quiet
STATUS=$?
if [ "$STATUS" -ne 0 ] && [ "$STATUS" -ne 8 ]; then
    # 0=변경없음, 8=일부 파일 수정됨(정상). 그 외는 실제 오류.
    echo "✖ pre-commit: php-cs-fixer 오류(코드 $STATUS) — 커밋 중단"
    exit 1
fi

# 포맷으로 바뀐 파일을 다시 스테이징
echo "$FILES" | xargs git add
exit 0
